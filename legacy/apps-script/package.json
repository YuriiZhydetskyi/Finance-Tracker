{
  "name": "finance-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "Personal finance tracker for two: photo-based receipt parsing via Gemini, Google Sheets as storage, Apps Script web app.",
  "scripts": {
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "push": "npm run lint && npm run typecheck && npm run test && clasp push",
    "push:force": "clasp push",
    "pull": "clasp pull",
    "open": "clasp open",
    "deploy": "clasp deploy",
    "logs": "clasp logs"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@google/clasp": "^3.2.0",
    "@types/google-apps-script": "^1.0.83",
    "@xmldom/xmldom": "^0.9.5",
    "alpinejs": "^3.15.12",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18"
  }
}
