{
  "name": "finance-tracker",
  "version": "0.2.7",
  "private": true,
  "description": "Personal finance tracker — React + Vite + Supabase. Photo-receipt OCR via Gemini/Claude, multi-currency, two-user.",
  "workspaces": [
    "web",
    "packages/*",
    "supabase/functions/*"
  ],
  "scripts": {
    "dev": "npm --workspace web run dev",
    "build": "npm --workspace web run build",
    "preview": "npm --workspace web run preview",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test:unit && npm run test:purchase-correction-sql && npm run test:packaged-products-sql && npm run test:save-receipt-bundle-sql && npm run test:email-imports-sql && npm run test:canonical-stores-sql && npm run test:merge-products-sql && npm run test:packaging-exclusion-sql && npm run check:edge-domain",
    "test:unit": "npm run router:gen --workspace @finance-tracker/web && vitest run",
    "test:purchase-correction-sql": "node scripts/test-purchase-correction-rules.mjs",
    "test:packaged-products-sql": "node scripts/test-packaged-products-sql.mjs",
    "test:save-receipt-bundle-sql": "node scripts/test-save-receipt-bundle-sql.mjs",
    "test:email-imports-sql": "node scripts/test-email-imports-sql.mjs",
    "test:canonical-stores-sql": "node scripts/test-canonical-stores-sql.mjs",
    "test:merge-products-sql": "node scripts/test-merge-products-sql.mjs",
    "test:packaging-exclusion-sql": "node scripts/test-packaging-exclusion-sql.mjs",
    "sync:edge-domain": "node scripts/sync-edge-domain.mjs",
    "check:edge-domain": "node scripts/sync-edge-domain.mjs --check",
    "prepare": "husky"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.12",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "supabase": "^2.122.0",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "prettier --write"
    ],
    "*.{json,md,css,html,yml,yaml}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "eslint-plugin-react": {
      "eslint": "^10.13.0"
    }
  },
  "engines": {
    "node": ">=24.15"
  }
}
