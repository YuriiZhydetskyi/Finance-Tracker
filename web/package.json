{
  "name": "@finance-tracker/web",
  "version": "0.2.7",
  "private": true,
  "type": "module",
  "scripts": {
    "router:gen": "tsr generate",
    "pdf:assets": "node ../scripts/copy-pdf-assets.mjs",
    "dev": "npm run pdf:assets && vite",
    "build": "npm run pdf:assets && tsr generate && tsc -b && vite build",
