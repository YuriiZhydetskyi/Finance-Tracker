    "@tanstack/react-router": "^1.170.46",
    "chart.js": "^4.6.1",
    "clsx": "^2.1.1",
    "heic-to": "^1.6.6",
    "pdfjs-dist": "6.4.299",
    "react": "^19.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "tailwind-merge": "^3.7.0",
    "tus-js-client": "^4.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@eslint/compat": "^2.1.1",
