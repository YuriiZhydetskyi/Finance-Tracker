    "lint": "tsr generate && eslint . --cache",
    "lint:fix": "tsr generate && eslint . --cache --fix",
    "typecheck": "tsr generate && tsc -b --noEmit",
    "test": "tsr generate && vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@finance-tracker/domain": "*",
    "@hookform/resolvers": "^6.0.0",
    "@supabase/supabase-js": "^2.118.0",
