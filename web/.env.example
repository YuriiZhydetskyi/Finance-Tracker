# Local environment template. Copy to web/.env.local and fill in values.
# .env.local is gitignored. Never commit real keys.

# Supabase project URL — from Dashboard → Settings → API Keys → Project URL.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase anon public key — safe to ship to the browser. RLS gates all access.
# From Dashboard → Settings → API Keys → Project API keys → `anon` `public`.
VITE_SUPABASE_ANON_KEY=eyJ...
